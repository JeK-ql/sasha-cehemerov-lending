# WayForPay (кабінет merchant)
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_DOMAIN=isusneisus.com
WAYFORPAY_SECRET_KEY=

# Nova Poshta API
NOVAPOSHTA_API_KEY=

# Telegram (бот + чат менеджерів)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MongoDB Atlas (склад і замовлення)
MONGODB_URI=

# Google Таблиця оплачених замовлень (службовий акаунт, аркуш «paid»).
# Порожньо — запис у таблицю вимкнений. Ключ — поле private_key з JSON,
# переноси рядків можна лишити як \n.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Публічний URL сайту
NEXT_PUBLIC_SITE_URL=https://isusneisus.com
